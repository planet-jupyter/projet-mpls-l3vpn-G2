            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "subscription_name": true,
              "subinterface_index": true
            },
            "renameByName": {
              "source": "Routeur",
              "interface_name": "Interface",
              "address_ip": "IP",
              "Value #A": "État",
              "Value #B": "Masque"
            },
            "indexByName": {
              "source": 0,
              "interface_name": 1,
              "address_ip": 2,
              "Value #A": 3,
